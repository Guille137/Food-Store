    [
      "detalle_pedido",
      "trg_validar_edicion_detalle_pedido",
      "CREATE TRIGGER trg_validar_edicion_detalle_pedido BEFORE INSERT OR DELETE OR UPDATE ON public.detalle_pedido FOR EACH ROW EXECUTE FUNCTION validar_edicion_detalle_pedido()",
      "CREATE OR REPLACE FUNCTION public.validar_edicion_detalle_pedido()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n    v_id_pedido INTEGER;\n    v_ids INTEGER[];\n    v_estado estado_pedido;\nBEGIN\n    IF TG_OP = 'INSERT' THEN\n        v_ids := ARRAY[NEW.id_pedido];\n    ELSIF TG_OP = 'DELETE' THEN\n        v_ids := ARRAY[OLD.id_pedido];\n    ELSE\n        -- Mover una línea modifica tanto el pedido de origen como el de destino.\n        v_ids := ARRAY[OLD.id_pedido, NEW.id_pedido];\n    END IF;\n\n    -- Orden fijo para que dos traslados no tomen los pedidos en orden inverso.\n    FOR v_id_pedido IN\n        SELECT DISTINCT id FROM unnest(v_ids) AS ids(id) ORDER BY id\n    LOOP\n        SELECT estado INTO v_estado\n        FROM pedido\n        WHERE id_pedido = v_id_pedido\n        FOR SHARE;\n\n        -- FOR SHARE bloquea también UPDATE de estado. FOR KEY SHARE no lo hacía.\n        IF NOT FOUND THEN\n            RAISE EXCEPTION 'El pedido % no existe', v_id_pedido USING ERRCODE = '23503';\n        END IF;\n\n        IF v_estado <> 'PENDIENTE' THEN\n            RAISE EXCEPTION 'No se puede editar el detalle del pedido % porque está %', v_id_pedido, v_estado\n                USING ERRCODE = '23514';\n        END IF;\n    END LOOP;\n\n    IF TG_OP = 'DELETE' THEN\n        RETURN OLD;\n    END IF;\n\n    RETURN NEW;\nEND;\n$function$\n"
    ],
    [
      "detalle_pedido",
      "trg_validar_producto_y_stock_detalle",
      "CREATE TRIGGER trg_validar_producto_y_stock_detalle BEFORE INSERT OR UPDATE OF id_producto, cantidad ON public.detalle_pedido FOR EACH ROW EXECUTE FUNCTION validar_producto_y_stock_detalle()",
      "CREATE OR REPLACE FUNCTION public.validar_producto_y_stock_detalle()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n    v_stock INTEGER;\n    v_activo BOOLEAN;\nBEGIN\n    SELECT stock, activo INTO v_stock, v_activo\n    FROM producto\n    WHERE id_producto = NEW.id_producto\n    FOR SHARE;\n\n    IF NOT FOUND THEN\n        RAISE EXCEPTION 'El producto % no existe', NEW.id_producto USING ERRCODE = '23503';\n    END IF;\n\n    IF NOT v_activo THEN\n        RAISE EXCEPTION 'El producto % está inactivo', NEW.id_producto USING ERRCODE = '23514';\n    END IF;\n\n    IF NEW.cantidad > v_stock THEN\n        RAISE EXCEPTION 'Stock insuficiente para el producto %: solicitado %, disponible %',\n            NEW.id_producto, NEW.cantidad, v_stock USING ERRCODE = '23514';\n    END IF;\n\n    RETURN NEW;\nEND;\n$function$\n"
    ],
    [
      "pedido",
      "trg_validar_transicion_estado_pedido",
      "CREATE TRIGGER trg_validar_transicion_estado_pedido BEFORE UPDATE OF estado ON public.pedido FOR EACH ROW EXECUTE FUNCTION validar_transicion_estado_pedido()",
      "CREATE OR REPLACE FUNCTION public.validar_transicion_estado_pedido()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n    IF NEW.estado = OLD.estado THEN\n        RETURN NEW;\n    END IF;\n\n    IF (OLD.estado = 'PENDIENTE' AND NEW.estado IN ('CONFIRMADO', 'CANCELADO'))\n       OR (OLD.estado = 'CONFIRMADO' AND NEW.estado IN ('ENTREGADO', 'CANCELADO')) THEN\n        RETURN NEW;\n    END IF;\n\n    RAISE EXCEPTION 'Transición de estado no permitida: % -> %', OLD.estado, NEW.estado\n        USING ERRCODE = '23514';\nEND;\n$function$\n"
    ]
  ],
